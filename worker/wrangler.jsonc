{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "slipstream-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2025-06-01",
	"compatibility_flags": ["nodejs_compat"],
	"durable_objects": {
		"bindings": [{ "name": "MCP_OBJECT", "class_name": "FitnessMCP" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["FitnessMCP"] }],
	"observability": { "enabled": true }
}
